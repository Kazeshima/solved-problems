  rw [show List.range 256=(List.range' 0 16) ++ (List.range' 16 16) ++ (List.range' 32 16) ++ (List.range' 48 16) ++ (List.range' 64 16) ++ (List.range' 80 16) ++ (List.range' 96 16) ++ (List.range' 112 16) ++ (List.range' 128 16) ++ (List.range' 144 16) ++ (List.range' 160 16) ++ (List.range' 176 16) ++ (List.range' 192 16) ++ (List.range' 208 16) ++ (List.range' 224 16) ++ (List.range' 240 16) by decide +kernel]
