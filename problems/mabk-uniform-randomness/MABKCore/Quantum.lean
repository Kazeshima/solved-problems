import MABKCore.Basic

namespace MABK
open Finset Set
noncomputable section

def coefficient (n k : ℕ) : ℂ :=
  ((2/(2:ℝ)^n * Real.cos (((n:ℝ)-1)*Real.pi/4-(k:ℝ)*Real.pi/2):ℝ):ℂ)

/-- The product has a fixed order even in a noncommutative ambient algebra. -/
def word {n : ℕ} {A : Type*} [Monoid A] (v : Fin n → A) : A :=
  ((univ : Finset (Fin n)).toList.map v).prod

def phaseOperator {A : Type*} [Ring A] [Algebra ℂ A] (n : ℕ) (U : Fin n → A) : A :=
  ∑ s ∈ (univ : Finset (Fin n)).powerset,
    algebraMap ℂ A (coefficient n s.card) * word (fun j => if j ∈ s then U j else 1)

private theorem map_phase {A B : Type*} [Ring A] [Ring B] [Algebra ℂ A] [Algebra ℂ B]
    (f : A →ₐ[ℂ] B) (n : ℕ) (U : Fin n → A) :
    f (phaseOperator n U) = phaseOperator n (fun i => f (U i)) := by
  classical
  simp only [phaseOperator, map_sum, map_mul, AlgHom.commutes, word, map_list_prod, List.map_map]
  congr 1
  ext s
  congr 2
  apply congrArg (fun g : Fin n → B => (univ : Finset (Fin n)).toList.map g)
  funext i
  by_cases h : i ∈ s <;> simp [Function.comp_def,h]

private theorem phase_complex (n : ℕ) (z : Fin n → ℂ) : phaseOperator n z = poly n z := by
  classical
  unfold phaseOperator poly word
  apply Finset.sum_congr rfl
  intro s hs
  simp only [Finset.prod_map_toList, ← Finset.prod_filter]
  simp [coefficient]

private theorem commutative_phase_bound {B : Type*} [CommCStarAlgebra B] (n : ℕ)
    (V : Fin n → B) (hV : ∀ i, V i ∈ unitary B) (t : ℂ) (r : ℝ) (hr : 0 ≤ r)
    (h : ∀ z : Fin n → ℂ, (∀ i, ‖z i‖ = 1) → ‖poly n z - t‖ ≤ r) :
    ‖phaseOperator n V - algebraMap ℂ B t‖ ≤ r := by
  let p := phaseOperator n V - algebraMap ℂ B t
  change ‖p‖ ≤ r
  have he := (gelfandTransform_isometry B).norm_map_of_map_zero (map_zero _) p
  rw [← he, ContinuousMap.norm_le _ hr]
  intro χ
  let f := (ContinuousMap.evalStarAlgHom ℂ ℂ χ).comp (gelfandStarTransform B : B →⋆ₐ[ℂ] _)
  change ‖f p‖ ≤ r
  have hunit (i) : f (V i) ∈ unitary ℂ := by
    constructor
    · rw [← map_star, ← map_mul, (hV i).1, map_one]
    · rw [← map_star, ← map_mul, (hV i).2, map_one]
  change ‖f.toAlgHom (phaseOperator n V - algebraMap ℂ B t)‖ ≤ r
  rw [map_sub, map_phase, phase_complex, f.toAlgHom.commutes]
  exact h _ (fun i => CStarRing.norm_of_mem_unitary (hunit i))

/-- Joint spectral bound proved by taking characters of the closed abelian
star algebra generated by the commuting unitaries. The ambient algebra,
which can be the bounded operators on any complex Hilbert space, need not commute. -/
theorem joint_spectral_bound {A : Type*} [CStarAlgebra A] (n : ℕ)
    (U : Fin n → A) (hu : ∀ i, U i ∈ unitary A)
    (hc : ∀ i j, Commute (U i) (U j)) (t : ℂ) (r : ℝ) (hr : 0 ≤ r)
    (h : ∀ z : Fin n → ℂ, (∀ i, ‖z i‖ = 1) → ‖poly n z - t‖ ≤ r) :
    ‖phaseOperator n U - algebraMap ℂ A t‖ ≤ r := by
  classical
  let S := StarAlgebra.adjoin ℂ (range U)
  have hstar (i j) : U i * star (U j) = star (U j) * U i := by
    calc
      _ = (star (U j)*U j) * U i * star (U j) := by rw [(hu j).1, one_mul]
      _ = star (U j) * ((U j * U i) * star (U j)) := by simp only [mul_assoc]
      _ = _ := by rw [(hc j i).eq, mul_assoc, (hu j).2, mul_one]
  letI : CommRing S := StarAlgebra.adjoinCommRingOfComm ℂ
    (fun _ ⟨i,hi⟩ _ ⟨j,hj⟩ => hi ▸ hj ▸ (hc i j).eq)
    (fun _ ⟨i,hi⟩ _ ⟨j,hj⟩ => hi ▸ hj ▸ hstar i j)
  let B := S.topologicalClosure
  letI : CommRing B := S.commRingTopologicalClosure (fun x y => mul_comm x y)
  letI : NormedCommRing B := { SubringClass.toNormedRing B with mul_comm := mul_comm }
  letI : CompleteSpace B := S.isClosed_topologicalClosure.completeSpace_coe
  letI : CommCStarAlgebra B := { mul_comm := mul_comm, norm_mul_self_le := CStarRing.norm_mul_self_le }
  let V (i : Fin n) : B := ⟨U i, S.le_topologicalClosure (StarAlgebra.subset_adjoin ℂ (range U) ⟨i,rfl⟩)⟩
  have hV (i) : V i ∈ unitary B :=
    ⟨Subtype.ext (hu i).1, Subtype.ext (hu i).2⟩
  let p : B := phaseOperator n V - algebraMap ℂ B t
  have hval : (p : A) = phaseOperator n U - algebraMap ℂ A t := by
    change B.toSubalgebra.val (phaseOperator n V - algebraMap ℂ B t) = _
    rw [map_sub, map_phase]
    rfl
  rw [← hval]
  change ‖p‖ ≤ r
  exact commutative_phase_bound n V hV t r hr h

/-- Binary projective measurements, allowed to act on an arbitrary common
space. Only different parties are required to commute. -/
structure ProjectiveStrategy (n : ℕ) (A : Type*) [CStarAlgebra A] where
  obs : Fin n → Bool → A
  unitary_mem : ∀ i x, obs i x ∈ unitary A
  selfAdjoint : ∀ i x, star (obs i x) = obs i x
  locality : ∀ i j, i ≠ j → ∀ x y, Commute (obs i x) (obs j y)

private theorem word_mul {n : ℕ} {A : Type*} [Monoid A] (a b : Fin n → A)
    (hc : ∀ i j, i ≠ j → Commute (b i) (a j)) :
    word a * word b = word (fun i => a i * b i) := by
  have aux (l : List (Fin n)) (hl : l.Nodup) :
      (l.map a).prod * (l.map b).prod = (l.map (fun i => a i*b i)).prod := by
    induction l with
    | nil => simp
    | cons i l ih =>
      have hnot := (List.nodup_cons.mp hl).1
      have hh := Commute.list_prod_right (l.map a) (b i) (by
        intro v hv
        obtain ⟨j,hj,rfl⟩ := List.mem_map.mp hv
        exact hc _ _ (fun he => hnot (he ▸ hj)))
      simp only [List.map_cons,List.prod_cons]
      calc
        _ = a i * ((l.map a).prod * b i) * (l.map b).prod := by simp only [mul_assoc]
        _ = a i * (b i * (l.map a).prod) * (l.map b).prod := by rw [hh.eq]
        _ = _ := by simp only [mul_assoc, ih (List.nodup_cons.mp hl).2]
  exact aux _ (Finset.nodup_toList _)

def bellOperator {n : ℕ} {A : Type*} [CStarAlgebra A] (P : ProjectiveStrategy n A) : A :=
  ∑ s ∈ (univ : Finset (Fin n)).powerset, algebraMap ℂ A (coefficient n s.card) *
    word (fun i => P.obs i (decide (i ∈ s)))

/-- Given the scalar polynomial bound, the normalized MABK upper bound holds
for all projective quantum strategies and all contractive linear state
functionals. No spectral or phase representation is assumed. -/
theorem projective_bound_of_disk {n : ℕ} {A : Type*} [CStarAlgebra A]
    (P : ProjectiveStrategy n A) (ω : A →L[ℂ] ℂ) (hω : ‖ω‖ ≤ 1)
    (zero : ω (word (fun i => P.obs i false)) = 0) (disk : TorusDiskClaim n) :
    ‖ω (bellOperator P)‖ ≤ radius n := by
  classical
  let a := fun i => P.obs i false
  let U := fun i => a i * P.obs i true
  have hu (i) : U i ∈ unitary A := (unitary A).mul_mem (P.unitary_mem i _) (P.unitary_mem i _)
  have hc (i j) : Commute (U i) (U j) := by
    by_cases hij : i = j
    · rw [hij]
    · exact ((P.locality i j hij false false).mul_left (P.locality i j hij true false)).mul_right
        ((P.locality i j hij false true).mul_left (P.locality i j hij true true))
  have hi (i) : a i * a i = 1 := by
    simpa [a, P.selfAdjoint] using (P.unitary_mem i false).1
  have hw (s : Finset (Fin n)) :
      word a * word (fun i => if i ∈ s then U i else 1) =
        word (fun i => P.obs i (decide (i ∈ s))) := by
    rw [word_mul]
    · congr 1
      funext i
      by_cases h : i ∈ s <;> simp [h,U,← mul_assoc,hi,a]
    · intro i j hij
      by_cases h : i ∈ s
      · simp only [h, if_true]
        exact (P.locality i j hij false false).mul_left (P.locality i j hij true false)
      · simp [h]
  have hb : word a * phaseOperator n U = bellOperator P := by
    unfold phaseOperator bellOperator
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro s hs
    rw [← mul_assoc, ← Algebra.commutes, mul_assoc, hw]
  have hwa : word a ∈ unitary A := by
    apply Submonoid.list_prod_mem
    intro v hv
    obtain ⟨i,_,rfl⟩ := List.mem_map.mp hv
    exact P.unitary_mem i false
  have hr : 0 ≤ radius n := (norm_nonneg _).trans (disk (fun _ => 1) (by simp))
  have hspec := joint_spectral_bound n U hu hc (center n) (radius n) hr disk
  let X := phaseOperator n U - algebraMap ℂ A (center n:ℂ)
  have hshift : ω (word a * X) = ω (bellOperator P) := by
    dsimp [X]
    rw [mul_sub, hb, ← Algebra.commutes, ← Algebra.smul_def, map_sub, map_smul, zero, smul_zero, sub_zero]
  rw [← hshift]
  calc
    _ ≤ ‖ω‖ * ‖word a * X‖ := ω.le_opNorm _
    _ ≤ 1 * ‖word a * X‖ := mul_le_mul_of_nonneg_right hω (norm_nonneg _)
    _ ≤ _ := by rw [one_mul, CStarRing.norm_mem_unitary_mul _ hwa]; exact hspec

end
end MABK
